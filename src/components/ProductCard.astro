---
import { Icon } from "astro-icon/components";
import { type Product, formatPrice } from "../data";

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const transitionName = product.slug;
const href = `/product/${product.slug}`;
---

<article
  class="group relative flex flex-col"
  data-product-card
  data-price={product.price}
  data-index={index}
  data-name={product.name}
>
  <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-white ring-1 ring-line/70 transition-shadow duration-500 group-hover:shadow-2xl group-hover:shadow-ink/10">
    <img
      src={product.cover}
      alt={product.name}
      width="768"
      height="768"
      loading={index < 4 ? "eager" : "lazy"}
      decoding="async"
      transition:name={`${transitionName} image`}
      class="size-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
    />
    {product.badge && (
      <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold tracking-wide text-ink uppercase shadow-sm backdrop-blur">
        {product.badge}
      </span>
    )}
    <button
      type="button"
      data-quick-add
      data-slug={product.slug}
      data-name={product.name}
      data-price={product.price}
      data-cover={product.cover}
      class="absolute inset-x-2 bottom-2 z-10 flex translate-y-2 items-center justify-center gap-1.5 rounded-full bg-ink/90 px-3 py-2 text-xs sm:inset-x-3 sm:bottom-3 sm:gap-2 sm:px-4 sm:py-2.5 sm:text-sm font-medium text-paper opacity-0 backdrop-blur transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 hover:bg-ink focus-visible:translate-y-0 focus-visible:opacity-100 [@media(hover:none)]:translate-y-0 [@media(hover:none)]:opacity-100"
      aria-label={`Quick add ${product.name}, size M, to bag`}
    >
      <Icon name="mdi:plus" class="size-4" />
      <span data-quick-add-label>Quick add · M</span>
    </button>
  </div>

  <div class="flex flex-col gap-1 pt-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4 sm:pt-4">
    <div class="min-w-0">
      <h3
        class="truncate font-medium"
        transition:name={`${transitionName} title`}
      >
        <a
          href={href}
          class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-ink"
        >
          {product.name}
        </a>
      </h3>
      <p
        class="mt-1 line-clamp-1 text-sm text-muted"
        transition:name={`${transitionName} description`}
      >
        {product.description}
      </p>
    </div>
    <p
      class="shrink-0 text-sm font-semibold tabular-nums sm:text-base"
      transition:name={`${transitionName} price`}
    >
      {formatPrice(product.price)}
    </p>
  </div>
</article>

<script>
  import { addToCart, openCart } from "../scripts/cart";

  // Delegated so it keeps working after View Transition navigations.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest?.<HTMLButtonElement>(
      "[data-quick-add]",
    );
    if (!button) return;
    const { slug, name, price, cover } = button.dataset;
    if (!slug || !name || !price || !cover) return;
    addToCart({
      slug,
      name,
      price: Number(price),
      cover,
      size: "M",
      quantity: 1,
    });
    openCart();
  });
</script>
