---
import { type Product, formatPrice } from "../data";

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const transitionName = product.slug;
---

<a
  href={`/product/${product.slug}`}
  class="group block"
  data-product-card
  data-price={product.price}
  data-index={index}
  data-name={product.name}
>
  <article>
    <div class="aspect-square overflow-hidden rounded-lg bg-surface">
      <img
        src={product.cover}
        alt={product.name}
        width="768"
        height="768"
        decoding="async"
        transition:name={`${transitionName} image`}
        class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      />
    </div>
    <div class="mt-3 flex items-baseline justify-between gap-3 text-sm">
      <h3
        class="truncate font-medium"
        transition:name={`${transitionName} title`}
      >
        {product.name}
      </h3>
      <p
        class="shrink-0 tabular-nums"
        transition:name={`${transitionName} price`}
      >
        {formatPrice(product.price)}
      </p>
    </div>
    <p
      class="mt-0.5 truncate text-sm text-muted"
      transition:name={`${transitionName} description`}
    >
      {product.description}
    </p>
  </article>
</a>
