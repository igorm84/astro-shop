---
import { type Product, formatPrice } from "../data";

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const transitionName = product.slug;
---

<a
  href={`/product/${product.slug}`}
  class="group rail block px-2 pb-2 sm:px-4"
  data-product-card
  data-price={product.price}
  data-index={index}
  data-name={product.name}
>
  <article>
    <img
      src={product.cover}
      alt={product.name}
      width="768"
      height="768"
      decoding="async"
      transition:name={`${transitionName} image`}
      class="hang aspect-square w-full object-cover object-top motion-safe:group-hover:rotate-[1.5deg]"
    />
    <h3
      class="mt-3 truncate font-medium"
      transition:name={`${transitionName} title`}
    >
      {product.name}
    </h3>
    <p transition:name={`${transitionName} price`}>
      {formatPrice(product.price)}
    </p>
    <p
      class="mt-1 line-clamp-2 text-sm text-muted"
      transition:name={`${transitionName} description`}
    >
      {product.description}
    </p>
  </article>
</a>
