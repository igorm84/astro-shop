---
import { type Product, sizes } from "../data";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const DEFAULT_SIZE = "M";
---

<add-to-cart
  data-slug={product.slug}
  data-name={product.name}
  data-price={product.price}
  data-cover={product.cover}
>
  <form>
    <p id="size-label" class="text-sm font-medium">
      Size
    </p>
    <div
      role="radiogroup"
      aria-labelledby="size-label"
      data-sizes
      class="mt-3 flex flex-wrap gap-2"
    >
      {sizes.map((size) => (
        <button
          type="button"
          role="radio"
          data-size={size}
          aria-checked={size === DEFAULT_SIZE ? "true" : "false"}
          tabindex={size === DEFAULT_SIZE ? 0 : -1}
          class="flex h-11 w-13 items-center justify-center rounded-sm border border-line text-sm transition-colors hover:border-ink aria-checked:border-ink aria-checked:bg-ink aria-checked:text-paper"
        >
          {size}
        </button>
      ))}
    </div>

    <button
      type="submit"
      class="mt-6 h-12 w-full rounded-sm bg-ink px-8 font-medium text-paper transition-colors hover:bg-ink/80 sm:w-auto sm:min-w-64"
    >
      <span data-label>Add to bag</span>
    </button>
    <p data-status class="sr-only" role="status"></p>
  </form>
</add-to-cart>

<script>
  import { addToCart, openCart } from "../scripts/cart";

  class AddToCart extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector("form")!;
      const label = form.querySelector<HTMLElement>("[data-label]")!;
      const group = form.querySelector<HTMLElement>("[data-sizes]")!;
      const radios = [
        ...group.querySelectorAll<HTMLButtonElement>("[role=radio]"),
      ];
      let timer: ReturnType<typeof setTimeout> | undefined;

      // Radio-group behaviour: one tab stop, arrow keys move and select.
      const check = (radio: HTMLButtonElement) => {
        for (const r of radios) {
          const on = r === radio;
          r.setAttribute("aria-checked", String(on));
          r.tabIndex = on ? 0 : -1;
        }
        radio.focus();
      };
      const selected = () =>
        radios.find((r) => r.getAttribute("aria-checked") === "true") ??
        radios[0];

      group.addEventListener("click", (event) => {
        const radio = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "[role=radio]",
        );
        if (radio) check(radio);
      });
      group.addEventListener("keydown", (event) => {
        const step = {
          ArrowRight: 1,
          ArrowDown: 1,
          ArrowLeft: -1,
          ArrowUp: -1,
        }[event.key];
        if (!step) return;
        event.preventDefault();
        const i = radios.indexOf(selected());
        check(radios[(i + step + radios.length) % radios.length]);
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const { slug, name, price, cover } = this.dataset;
        if (!slug || !name || !price || !cover) return;
        const size = selected().dataset.size ?? "M";

        addToCart({
          slug,
          name,
          price: Number(price),
          cover,
          size,
          quantity: 1,
        });

        label.textContent = "Added to bag";
        form.querySelector("[data-status]")!.textContent =
          `Added ${name}, size ${size}, to your bag.`;
        clearTimeout(timer);
        timer = setTimeout(() => (label.textContent = "Add to bag"), 1500);

        openCart();
      });
    }
  }

  if (!customElements.get("add-to-cart")) {
    customElements.define("add-to-cart", AddToCart);
  }
</script>
