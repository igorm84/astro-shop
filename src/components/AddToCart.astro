---
import { type Product, sizes } from "../data";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<add-to-cart
  data-slug={product.slug}
  data-name={product.name}
  data-price={product.price}
  data-cover={product.cover}
>
  <form>
    <fieldset>
      <legend class="text-sm font-medium">Size</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {sizes.map((size) => (
          <label>
            <input
              type="radio"
              name="size"
              value={size}
              checked={size === "M"}
              class="peer sr-only"
            />
            <span class="flex h-11 w-13 items-center justify-center rounded-sm border border-line text-sm transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink hover:border-ink">
              {size}
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <button
      type="submit"
      class="mt-6 h-12 w-full rounded-sm bg-ink px-8 font-medium text-paper transition-colors hover:bg-ink/80 sm:w-auto sm:min-w-64"
    >
      <span data-label>Add to bag</span>
    </button>
    <p data-status class="sr-only" role="status"></p>
  </form>
</add-to-cart>

<script>
  import { addToCart, openCart } from "../scripts/cart";

  class AddToCart extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector("form")!;
      const label = form.querySelector<HTMLElement>("[data-label]")!;
      let timer: ReturnType<typeof setTimeout> | undefined;

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const { slug, name, price, cover } = this.dataset;
        if (!slug || !name || !price || !cover) return;
        const size = String(new FormData(form).get("size") ?? "M");

        addToCart({
          slug,
          name,
          price: Number(price),
          cover,
          size,
          quantity: 1,
        });

        label.textContent = "Added to bag";
        form.querySelector("[data-status]")!.textContent =
          `Added ${name}, size ${size}, to your bag.`;
        clearTimeout(timer);
        timer = setTimeout(() => (label.textContent = "Add to bag"), 1500);

        openCart();
      });
    }
  }

  if (!customElements.get("add-to-cart")) {
    customElements.define("add-to-cart", AddToCart);
  }
</script>
