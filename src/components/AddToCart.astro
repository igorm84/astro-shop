---
import { Icon } from "astro-icon/components";
import { type Product, sizes } from "../data";
import { MAX_QUANTITY } from "../scripts/cart";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<add-to-cart
  data-slug={product.slug}
  data-name={product.name}
  data-price={product.price}
  data-cover={product.cover}
>
  <form class="space-y-6">
    <fieldset>
      <div class="flex items-center justify-between">
        <legend class="text-sm font-semibold">Size</legend>
        <span class="text-xs text-muted">Regular fit · true to size</span>
      </div>
      <div class="mt-3 grid grid-cols-5 gap-2">
        {sizes.map((size) => (
          <label class="relative">
            <input
              type="radio"
              name="size"
              value={size}
              checked={size === "M"}
              class="peer sr-only"
            />
            <span class="flex h-12 items-center justify-center rounded-xl border border-line bg-white text-sm font-medium transition-all peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink hover:border-ink">
              {size}
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="flex gap-3">
      <div class="inline-flex h-14 shrink-0 items-center rounded-full border border-line bg-white">
        <button
          type="button"
          data-step="-1"
          class="grid size-12 place-items-center rounded-full text-ink-soft transition-colors hover:text-ink disabled:opacity-30"
          aria-label="Decrease quantity"
        >
          <Icon name="mdi:minus" class="size-4" />
        </button>
        <input
          type="number"
          name="quantity"
          value="1"
          min="1"
          max={MAX_QUANTITY}
          inputmode="numeric"
          aria-label="Quantity"
          class="w-8 [appearance:textfield] bg-transparent text-center font-semibold tabular-nums focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        />
        <button
          type="button"
          data-step="1"
          class="grid size-12 place-items-center rounded-full text-ink-soft transition-colors hover:text-ink disabled:opacity-30"
          aria-label="Increase quantity"
        >
          <Icon name="mdi:plus" class="size-4" />
        </button>
      </div>

      <button
        type="submit"
        class="group relative flex h-14 flex-1 items-center justify-center gap-2 overflow-hidden rounded-full bg-ink px-6 text-sm font-semibold text-paper transition-colors hover:bg-ink-soft"
      >
        <span data-label-default class="flex items-center gap-2">
          <Icon name="mdi:shopping-outline" class="size-5" />
          Add to bag
        </span>
        <span data-label-added class="hidden items-center gap-2">
          <Icon name="mdi:check" class="size-5" />
          Added to bag
        </span>
      </button>
    </div>
    <p data-status class="sr-only" role="status"></p>
  </form>
</add-to-cart>

<script>
  import { MAX_QUANTITY, addToCart, openCart } from "../scripts/cart";

  class AddToCart extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector("form")!;
      const quantity = form.querySelector<HTMLInputElement>(
        'input[name="quantity"]',
      )!;
      const steppers = form.querySelectorAll<HTMLButtonElement>("[data-step]");

      const clamp = (value: number) =>
        Math.min(MAX_QUANTITY, Math.max(1, Number.isFinite(value) ? value : 1));

      const sync = () => {
        const value = clamp(quantity.valueAsNumber);
        quantity.value = String(value);
        steppers.forEach((button) => {
          const step = Number(button.dataset.step);
          button.disabled =
            (step < 0 && value <= 1) || (step > 0 && value >= MAX_QUANTITY);
        });
      };

      steppers.forEach((button) =>
        button.addEventListener("click", () => {
          quantity.value = String(
            clamp(quantity.valueAsNumber + Number(button.dataset.step)),
          );
          sync();
        }),
      );
      quantity.addEventListener("change", sync);
      sync();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const { slug, name, price, cover } = this.dataset;
        if (!slug || !name || !price || !cover) return;
        const size = String(data.get("size") ?? "M");
        const qty = clamp(Number(data.get("quantity")));

        addToCart({
          slug,
          name,
          price: Number(price),
          cover,
          size,
          quantity: qty,
        });

        const submit = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        )!;
        const defaultLabel = submit.querySelector("[data-label-default]")!;
        const addedLabel = submit.querySelector("[data-label-added]")!;
        defaultLabel.classList.replace("flex", "hidden");
        addedLabel.classList.replace("hidden", "flex");
        form.querySelector("[data-status]")!.textContent =
          `Added ${qty} × ${name} (size ${size}) to your bag.`;
        setTimeout(() => {
          defaultLabel.classList.replace("hidden", "flex");
          addedLabel.classList.replace("flex", "hidden");
        }, 1800);

        openCart();
      });
    }
  }

  if (!customElements.get("add-to-cart")) {
    customElements.define("add-to-cart", AddToCart);
  }
</script>
