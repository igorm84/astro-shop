---
import { Icon } from "astro-icon/components";
import { FREE_SHIPPING_THRESHOLD, formatPrice } from "../data";

const isHome = Astro.url.pathname === "/";
---

<div class="bg-ink text-paper text-xs tracking-wide">
  <p class="mx-auto max-w-7xl px-4 py-2 text-center sm:px-6 lg:px-8">
    Free shipping on orders over {formatPrice(FREE_SHIPPING_THRESHOLD)}
    <span class="mx-2 hidden text-paper/40 sm:inline" aria-hidden="true">
      •
    </span>
    <span class="hidden text-paper/70 sm:inline">
      Demo store — nothing actually ships
    </span>
  </p>
</div>

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/80 backdrop-blur-lg supports-[backdrop-filter]:bg-paper/70">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-label="Astro Shop home"
    >
      <span class="grid size-8 place-items-center rounded-full bg-ink text-paper transition-transform duration-300 group-hover:-rotate-12">
        <svg
          viewBox="0 0 128 128"
          class="size-4 fill-current"
          aria-hidden="true"
        >
          <path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-5.3 8c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z"></path>
        </svg>
      </span>
      <span class="font-display text-2xl leading-none tracking-tight">
        Astro Shop
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 text-sm md:flex">
      <a
        href="/#products"
        class="text-ink-soft transition-colors hover:text-ink"
        aria-current={isHome ? "page" : undefined}
      >
        Shop all
      </a>
      <a href="/#about" class="text-ink-soft transition-colors hover:text-ink">
        About
      </a>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="https://github.com/igorm84/astro-shop"
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-10 place-items-center rounded-full text-ink-soft transition-colors hover:bg-sand hover:text-ink"
        aria-label="View source on GitHub"
      >
        <Icon name="mdi:github" class="size-5" />
      </a>
      <button
        type="button"
        data-cart-open
        class="relative grid size-10 place-items-center rounded-full text-ink-soft transition-colors hover:bg-sand hover:text-ink"
        aria-label="Open shopping bag"
      >
        <Icon name="mdi:shopping-outline" class="size-5" />
        <cart-count
          hidden
          class="absolute -top-0.5 -right-0.5 grid h-5 min-w-5 place-items-center rounded-full bg-accent px-1 text-[10px] font-semibold text-white tabular-nums ring-2 ring-paper"
        >
          0
        </cart-count>
      </button>
    </div>
  </div>
</header>

<script>
  import { CART_CHANGE, cartCount, getCart } from "../scripts/cart";

  class CartCount extends HTMLElement {
    #onChange = () => this.render(true);

    connectedCallback() {
      this.render(false);
      window.addEventListener(CART_CHANGE, this.#onChange);
    }

    disconnectedCallback() {
      window.removeEventListener(CART_CHANGE, this.#onChange);
    }

    render(animate: boolean) {
      const count = cartCount(getCart());
      this.textContent = count > 99 ? "99+" : String(count);
      this.hidden = count === 0;
      this.closest("button")?.setAttribute(
        "aria-label",
        count ? `Open shopping bag, ${count} items` : "Open shopping bag",
      );
      if (animate && count) {
        this.classList.remove("animate-bump");
        void this.offsetWidth;
        this.classList.add("animate-bump");
      }
    }
  }

  if (!customElements.get("cart-count")) {
    customElements.define("cart-count", CartCount);
  }
</script>
