---
import { Icon } from "astro-icon/components";
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="text-sm font-semibold tracking-tight">
      Astro Shop
    </a>

    <div class="flex items-center gap-5 text-sm">
      <a
        href="https://github.com/igorm84/astro-shop"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted transition-colors hover:text-ink"
        aria-label="View source on GitHub"
      >
        <Icon name="mdi:github" class="size-5" />
      </a>
      <button
        type="button"
        data-cart-open
        class="transition-colors hover:text-muted"
        aria-label="Open bag"
      >
        Bag (<cart-count>0</cart-count>)
      </button>
    </div>
  </div>
</header>

<script>
  import { CART_CHANGE, cartCount, getCart } from "../scripts/cart";

  class CartCount extends HTMLElement {
    #onChange = () => this.render();

    connectedCallback() {
      this.render();
      window.addEventListener(CART_CHANGE, this.#onChange);
    }

    disconnectedCallback() {
      window.removeEventListener(CART_CHANGE, this.#onChange);
    }

    render() {
      const count = cartCount(getCart());
      this.textContent = String(count);
      this.closest("button")?.setAttribute(
        "aria-label",
        `Open bag, ${count} ${count === 1 ? "item" : "items"}`,
      );
    }
  }

  if (!customElements.get("cart-count")) {
    customElements.define("cart-count", CartCount);
  }
</script>
