---
import { type Product, formatPrice, products } from "../../../data";
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import AddToCart from "../../../components/AddToCart.astro";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug } = product;

const similar = products.filter(
  (p) => p.category === product.category && p.id !== product.id,
);
---

<Layout
  title={product.name}
  description={product.description}
  image={product.cover}
>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 sm:pt-10">
    <a
      href="/"
      class="text-sm text-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
    >
      All shirts
    </a>

    <div class="mt-6 grid gap-10 md:grid-cols-2 md:gap-14">
      <figure>
        <div class="rail">
          <img
            src={product.cover}
            alt={product.name}
            width="768"
            height="768"
            fetchpriority="high"
            class="aspect-square w-full object-cover object-top"
            transition:name={`${slug} image`}
          />
        </div>
        <figcaption class="mt-3 text-xs text-muted">
          Photo by{" "}
          <a
            href={product.coverCredits}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:text-ink"
          >
            {product.coverAuthor}
          </a>{" "}
          on Unsplash
        </figcaption>
      </figure>

      <div class="md:pt-8">
        <h1
          class="text-4xl leading-[1.05] font-bold tracking-tight font-stretch-expanded sm:text-5xl"
          data-hide-on-leave
        >
          {product.name}
        </h1>
        <div transition:name={`${slug} title`}></div>
        <p class="mt-4 text-xl" transition:name={`${slug} price`}>
          {formatPrice(product.price)}
        </p>

        <p
          class="mt-6 max-w-[34rem] leading-relaxed text-muted"
          transition:name={`${slug} description`}
        >
          {product.description}
        </p>

        <div class="mt-10">
          <AddToCart {product} />
        </div>

        <dl class="mt-12 grid grid-cols-[6rem_1fr] gap-y-2 text-sm">
          <dt class="text-muted">Colour</dt>
          <dd>{product.color}</dd>
          <dt class="text-muted">Material</dt>
          <dd>100% organic cotton</dd>
          <dt class="text-muted">Returns</dt>
          <dd>Free within 30 days</dd>
        </dl>
      </div>
    </div>

    {similar.length > 0 && (
      <section class="mt-28" aria-labelledby="similar-title">
        <h2
          id="similar-title"
          class="text-2xl font-bold tracking-tight font-stretch-expanded"
        >
          More shirts
        </h2>
        <div class="-mx-2 mt-10 grid grid-cols-2 gap-y-14 sm:-mx-4 lg:grid-cols-4">
          {similar.map((pr, index) => (
            <ProductCard product={pr} {index} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // Hide the heading before navigating away so it doesn't linger while the
  // shared elements (image, price…) morph to their new positions.
  document.addEventListener("astro:before-preparation", () => {
    document.querySelector("[data-hide-on-leave]")?.classList.add("opacity-0");
  });
</script>
