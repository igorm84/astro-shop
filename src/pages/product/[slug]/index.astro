---
import { Icon } from "astro-icon/components";
import { type Product, formatPrice, products } from "../../../data";
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import AddToCart from "../../../components/AddToCart.astro";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { slug } = product;

const similar = products.filter(
  (p) => p.category === product.category && p.id !== product.id,
);
---

<Layout
  title={product.name}
  description={product.description}
  image={product.cover}
>
  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
    >
      <Icon name="mdi:arrow-left" class="size-4" />
      Back
    </a>

    <div class="mt-6 grid gap-8 md:grid-cols-2 md:gap-12">
      <figure>
        <div class="overflow-hidden rounded-lg bg-surface">
          <img
            src={product.cover}
            alt={product.name}
            width="768"
            height="768"
            fetchpriority="high"
            class="aspect-square w-full object-cover"
            transition:name={`${slug} image`}
          />
        </div>
        <figcaption class="mt-2 text-xs text-muted">
          Photo by{" "}
          <a
            href={product.coverCredits}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:text-ink"
          >
            {product.coverAuthor}
          </a>{" "}
          on Unsplash
        </figcaption>
      </figure>

      <div class="md:pt-2">
        <h1
          class="text-2xl font-semibold tracking-tight sm:text-3xl"
          data-hide-on-leave
        >
          {product.name}
        </h1>
        <div transition:name={`${slug} title`}></div>
        <p class="mt-2 text-lg tabular-nums" transition:name={`${slug} price`}>
          {formatPrice(product.price)}
        </p>

        <p
          class="mt-6 max-w-md leading-relaxed text-muted"
          transition:name={`${slug} description`}
        >
          {product.description}
        </p>

        <div class="mt-8">
          <AddToCart {product} />
        </div>

        <dl class="mt-10 space-y-3 border-t border-line pt-6 text-sm">
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 text-muted">Colour</dt>
            <dd>{product.color}</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 text-muted">Material</dt>
            <dd>100% organic cotton</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 text-muted">Shipping</dt>
            <dd>Free returns within 30 days</dd>
          </div>
        </dl>
        <p class="mt-6 text-xs text-muted">* This is a fictional price.</p>
      </div>
    </div>

    {similar.length > 0 && (
      <section class="mt-24" aria-labelledby="similar-title">
        <h2 id="similar-title" class="text-sm font-medium">
          Similar products
        </h2>
        <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4">
          {similar.map((pr, index) => (
            <ProductCard product={pr} {index} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // Hide the heading before navigating away so it doesn't linger while the
  // shared elements (image, price…) morph to their new positions.
  document.addEventListener("astro:before-preparation", () => {
    document.querySelector("[data-hide-on-leave]")?.classList.add("opacity-0");
  });
</script>
