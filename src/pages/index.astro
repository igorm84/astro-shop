---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { products } from "../data";
import ProductCard from "../components/ProductCard.astro";
---

<Layout title="Shop">
  <product-grid class="mx-auto block max-w-6xl px-4 pt-10 sm:px-6 sm:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <h1 class="text-4xl leading-none font-bold tracking-tight font-stretch-expanded sm:text-5xl">
          Shirts
        </h1>
        <p class="mt-3 text-muted">
          Everyday shirts in black and white. Pick one to see it up close.
        </p>
      </div>
      <label class="relative">
        <span class="sr-only">Sort shirts</span>
        <select
          data-sort
          class="appearance-none bg-transparent py-1 pr-6 font-medium transition-colors hover:text-muted"
        >
          <option value="featured">Featured</option>
          <option value="price-asc">Lowest price</option>
          <option value="price-desc">Highest price</option>
          <option value="name">Name</option>
        </select>
        <Icon
          name="mdi:chevron-down"
          class="pointer-events-none absolute top-1/2 right-0 size-4 -translate-y-1/2"
        />
      </label>
    </div>

    <div
      data-grid
      class="-mx-2 mt-14 grid grid-cols-2 gap-y-14 sm:-mx-4 lg:grid-cols-4"
    >
      {products.map((product, index) => (
        <ProductCard {product} {index} />
      ))}
    </div>
  </product-grid>
</Layout>

<script>
  class ProductGrid extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector<HTMLSelectElement>("[data-sort]");
      const grid = this.querySelector<HTMLElement>("[data-grid]");
      if (!select || !grid) return;

      select.addEventListener("change", () => {
        const cards = [
          ...grid.querySelectorAll<HTMLElement>("[data-product-card]"),
        ];
        const price = (el: HTMLElement) => Number(el.dataset.price);
        const compare: Record<
          string,
          (a: HTMLElement, b: HTMLElement) => number
        > = {
          featured: (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
          "price-asc": (a, b) => price(a) - price(b),
          "price-desc": (a, b) => price(b) - price(a),
          name: (a, b) =>
            (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
        };
        const sorted = cards.sort(compare[select.value] ?? compare.featured);

        const reorder = () => grid.append(...sorted);
        if (
          "startViewTransition" in document &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.startViewTransition(reorder);
        } else {
          reorder();
        }
      });
    }
  }

  if (!customElements.get("product-grid")) {
    customElements.define("product-grid", ProductGrid);
  }
</script>
