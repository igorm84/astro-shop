---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { products } from "../data";
import ProductCard from "../components/ProductCard.astro";
---

<Layout title="Shop">
  <product-grid class="mx-auto block max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          Shirts
        </h1>
        <p class="mt-1 text-sm text-muted">
          Take a look at our products, feel free to buy some.
        </p>
      </div>
      <label class="relative text-sm">
        <span class="sr-only">Sort products</span>
        <select
          data-sort
          class="appearance-none bg-transparent py-1 pr-6 text-muted transition-colors hover:text-ink focus:text-ink"
        >
          <option value="featured">Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name</option>
        </select>
        <Icon
          name="mdi:chevron-down"
          class="pointer-events-none absolute top-1/2 right-0 size-4 -translate-y-1/2 text-muted"
        />
      </label>
    </div>

    <div
      data-grid
      class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4"
    >
      {products.map((product, index) => (
        <ProductCard {product} {index} />
      ))}
    </div>
  </product-grid>
</Layout>

<script>
  class ProductGrid extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector<HTMLSelectElement>("[data-sort]");
      const grid = this.querySelector<HTMLElement>("[data-grid]");
      if (!select || !grid) return;

      select.addEventListener("change", () => {
        const cards = [
          ...grid.querySelectorAll<HTMLElement>("[data-product-card]"),
        ];
        const price = (el: HTMLElement) => Number(el.dataset.price);
        const compare: Record<
          string,
          (a: HTMLElement, b: HTMLElement) => number
        > = {
          featured: (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
          "price-asc": (a, b) => price(a) - price(b),
          "price-desc": (a, b) => price(b) - price(a),
          name: (a, b) =>
            (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
        };
        const sorted = cards.sort(compare[select.value] ?? compare.featured);

        const reorder = () => grid.append(...sorted);
        if (
          "startViewTransition" in document &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.startViewTransition(reorder);
        } else {
          reorder();
        }
      });
    }
  }

  if (!customElements.get("product-grid")) {
    customElements.define("product-grid", ProductGrid);
  }
</script>
