---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  image?: string;
  description?: string;
}

const {
  title,
  image = "/products/ryan-hoffman-A7f7XRKgUWc-unsplash.webp",
  description = "A simple Shop built in Astro using View Transitions and TailwindCSS",
} = Astro.props;

const imageUrl = import.meta.env.PUBLIC_URL
  ? new URL(image, import.meta.env.PUBLIC_URL)
  : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="product" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:description" content={description} />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-archivo" preload />
    <title>{title} · Astro Shop</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col font-sans">
    <a
      href="#main"
      class="sr-only z-50 bg-ink px-3 py-2 text-sm text-paper focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>
